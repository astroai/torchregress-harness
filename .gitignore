# Python bytecode / extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging artifacts
build/
dist/
*.egg-info/
src/*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
.env

# Test, coverage, and tool caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# OS/editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs / temp
*.log
*.tmp
*.prof

# Datasets (downloaded at runtime)
datasets/*.csv
datasets/*.parquet
datasets/*.npz
datasets/*.npy
datasets/*.h5

# Results (generated by harness runs)
results/latest/
results/archive/

# Keep directory structure files
!datasets/README.md

# UV cache / lock
.uv-cache/
uv.lock

# Model outputs
*.pt
*.pth
